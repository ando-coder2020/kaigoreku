---
import Base from '../../layouts/Base.astro';
import RekuCard from '../../components/RekuCard.astro';
import { SEASONS, BODY, BUDGET, LEVEL_WORD, SITUATIONS, getPublishedReku } from '../../lib/taxonomy';
const all = await getPublishedReku();
const latest = all.slice(0, 24);
const groups: [string, string[]][] = [
  ['状況', Object.values(SITUATIONS).map((s) => s.short)],
  ['季節', Object.values(SEASONS).map((s) => s.label)],
  ['きたえる', Object.values(BODY)],
  ['体力', Object.values(LEVEL_WORD)],
  ['司会', Object.values(LEVEL_WORD)],
  ['準備', Object.values(LEVEL_WORD)],
  ['予算', Object.values(BUDGET)],
  ['形に残る', ['あり']],
];
---
<Base title="レクを探す">
  <section class="wrap section">
    <h1 class="h1">レクを探す</h1>
    <form id="search-form" role="search" class="search">
      <label for="q" class="sr-only">キーワード</label>
      <input id="q" name="q" type="search" placeholder="例：秋 座ったまま 0円" autocomplete="off" />
      <button type="submit" class="btn">探す</button>
    </form>

    <details class="filters" open>
      <summary>条件でしぼりこむ</summary>
      <div class="filter-grid">
        {groups.map(([name, values]) => (
          <fieldset>
            <legend>{name === '体力' || name === '司会' || name === '準備' ? `${name}の負担` : name}</legend>
            <div class="opts">
              {values.map((v) => (
                <label class="opt"><input type="checkbox" name={name} value={v} /> <span>{v}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
      <button type="button" id="clear" class="btn is-outline">条件をすべて外す</button>
    </details>

    <p id="status" class="status" role="status" aria-live="polite">新着のレク（全{all.length}件）</p>
    <div id="latest" class="grid-cards">{latest.map((r, i) => <RekuCard reku={r} index={i} />)}</div>
    <ul id="results" class="results"></ul>
    <button type="button" id="more" class="btn is-outline" hidden>もっと見る</button>
  </section>
</Base>

<script>
  type PF = any;
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status')!;
  const results = document.getElementById('results')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const latest = document.getElementById('latest')!;
  const defaultStatus = status.textContent;
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filters input[type=checkbox]'));
  let pagefind: PF = null;
  let hits: any[] = [];
  let shown = 0;
  const STEP = 20;

  // URLの ?q= や ?状況=司会が苦手 を反映
  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  boxes.forEach((b) => { if (params.getAll(b.name).includes(b.value)) b.checked = true; });

  async function load() {
    if (pagefind) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ url);
      await pagefind.init();
    } catch {
      status.textContent = '検索の準備ができていません（npm run build 後に使えます）。';
    }
    return pagefind;
  }

  function filters() {
    const f: Record<string, { any: string[] }> = {};
    boxes.filter((b) => b.checked).forEach((b) => { (f[b.name] ||= { any: [] }).any.push(b.value); });
    f['種類'] = { any: ['レク'] };
    return f;
  }

  function escape(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  async function renderMore() {
    const slice = hits.slice(shown, shown + STEP);
    const datas = await Promise.all(slice.map((h) => h.data()));
    for (const d of datas) {
      const li = document.createElement('li');
      li.innerHTML = `<a href="${escape(d.url)}"><span class="r-title">${escape(d.meta.title ?? '')}</span><span class="r-loads">${escape(d.meta.loads ?? '')}</span></a>`;
      results.appendChild(li);
    }
    shown += slice.length;
    more.hidden = shown >= hits.length;
  }

  async function run() {
    const pf = await load();
    if (!pf) return;
    const term = input.value.trim() || null;
    const hasFilter = boxes.some((b) => b.checked);
    if (!term && !hasFilter) { latest.hidden = false; results.innerHTML = ''; more.hidden = true; status.textContent = defaultStatus; return; }
    latest.hidden = true;
    const res = await pf.search(term, { filters: filters() });
    hits = res.results;
    shown = 0;
    results.innerHTML = '';
    status.textContent = hits.length ? `${hits.length}件見つかりました` : '見つかりませんでした。条件を減らしてみてください。';
    await renderMore();
    // 今の条件をURLに残す（共有・ブックマーク用）
    const p = new URLSearchParams();
    if (term) p.set('q', term);
    boxes.filter((b) => b.checked).forEach((b) => p.append(b.name, b.value));
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); run(); });
  boxes.forEach((b) => b.addEventListener('change', run));
  document.getElementById('clear')!.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); run(); });
  more.addEventListener('click', renderMore);
  run();
</script>

<style>
  .h1 { font-size: 32px; margin-bottom: 20px; }
  .search { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .search input { flex: 1 1 240px; min-width: 0; height: 52px; padding: 0 16px; font-size: 16px; font-family: inherit; border: 1.5px solid var(--ink); border-radius: var(--radius); background: var(--card); color: var(--ink); }
  .filters { background: var(--card); border: 1px solid var(--line-2); padding: 16px 20px; margin-bottom: 24px; }
  .filters summary { font-weight: 700; cursor: pointer; min-height: 44px; display: flex; align-items: center; }
  .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 24px; margin: 12px 0 20px; }
  fieldset { border: none; padding: 0; margin: 0; }
  legend { font-size: 14px; font-weight: 700; color: var(--ink-3); margin-bottom: 6px; }
  .opts { display: flex; flex-wrap: wrap; gap: 6px; }
  .opt { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 4px 12px; background: var(--tape-bg); color: var(--tape-fg); cursor: pointer; font-size: 15px; }
  .opt input { width: 20px; height: 20px; accent-color: var(--ink); }
  .opt:has(input:checked) { background: var(--tape); color: var(--ink); font-weight: 700; }
  .status { color: var(--ink-3); margin-bottom: 12px; }
  #latest { margin-bottom: 24px; }
  .results { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 10px; }
  .results :global(a) { display: flex; flex-direction: column; gap: 2px; padding: 14px 18px; background: var(--card); border: 1px solid var(--line-2); text-decoration: none; color: var(--ink); }
  .results :global(a:hover) { border-color: var(--ink); }
  .results :global(.r-title) { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  .results :global(.r-loads) { font-size: 14px; color: var(--ink-3); }
</style>
