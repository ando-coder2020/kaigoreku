---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props { title?: string; description?: string; }
const { title, description = '介護施設のレクリエーションを、季節・目的・スタッフの負担・予算から探せる図鑑。' } = Astro.props;
const fullTitle = title ? `${title}｜介護レク図鑑` : '介護レク図鑑｜きょうの笑顔が、だれかの思い出になる。';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- 練習サイトのため検索エンジンに載せない。本番公開時に外す -->
  <meta name="robots" content="noindex, nofollow" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&family=BIZ+UDPGothic:wght@400;700&display=swap" />
</head>
<body>
  <a href="#main" class="sr-only">本文へ移動</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <MobileNav />
</body>
</html>
