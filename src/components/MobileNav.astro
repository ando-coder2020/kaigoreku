---
const items = [['/reku/', '探す'], ['/season/autumn/', '季節'], ['/download/', '塗り絵'], ['/favorites/', 'お気に入り']];
---
<nav aria-label="よく使うメニュー" class="mobile-nav no-print">
  {items.map(([href, label]) => <a href={href}>{label}</a>)}
</nav>
<script>
  // 季節リンクを閲覧日の季節に合わせる
  const m = new Date().getMonth() + 1;
  const s = m >= 3 && m <= 5 ? 'spring' : m >= 6 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
  document.querySelectorAll<HTMLAnchorElement>('a[href="/season/autumn/"]').forEach((a) => (a.href = `/season/${s}/`));
</script>
<style>
  .mobile-nav { display: none; }
  @media (max-width: 720px) {
    .mobile-nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); position: fixed; inset: auto 0 0 0; z-index: 10; background: var(--card); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom, 0px); }
    .mobile-nav a { min-height: 60px; display: flex; align-items: center; justify-content: center; color: var(--ink); text-decoration: none; font-weight: 700; font-size: 14px; }
  }
</style>
