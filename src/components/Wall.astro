---
// トップの壁面。季節の切り絵が1枚ずつ貼られて完成する（閲覧日の季節を表示。動きを減らす設定では静止）
import { WALLS } from '../lib/walls';
import { iconSvg } from '../lib/icons';
import { monthToSeason } from '../lib/taxonomy';
const now = monthToSeason(new Date().getMonth() + 1);
const labels = Object.fromEntries(Object.entries(WALLS).map(([k, v]) => [k, v.label]));

// 上部の旗（ガーランド）
const flagSvg = (colors: string[]) =>
  `<path d="M10 22 Q300 70 590 22" fill="none" stroke="#8C7F6C" stroke-width="2"/>` +
  Array.from({ length: 11 }, (_, i) => {
    const x = 30 + i * 54;
    const t = (x - 10) / 580;
    const y = 22 + 4 * 48 * t * (1 - t);
    return `<polygon points="${x - 16},${y} ${x + 16},${y} ${x},${y + 30}" fill="${colors[i % colors.length]}" stroke="#FFFDF8" stroke-width="1"/>`;
  }).join('');

const sets = Object.entries(WALLS).map(([key, w]) => {
  const items = w.items
    .map(([icon, x, y, size, rot, color], i) => {
      const s = size / 100;
      return `<g class="pin" style="--d:${0.15 + i * 0.22}s"><g transform="translate(${x} ${y}) rotate(${rot}) scale(${s})">
        <rect x="-8" y="-8" width="116" height="116" rx="12" fill="#FFFDF8" opacity=".9"/>
        <rect x="32" y="-16" width="36" height="14" fill="#E6C15A" opacity=".9" transform="rotate(-6 50 -9)"/>
        ${iconSvg(icon, color)}</g></g>`;
    })
    .join('');
  return `<g class="set" data-season="${key}">${flagSvg(w.flags)}${items}</g>`;
}).join('');
---
<div class="wall" data-active={now} data-labels={JSON.stringify(labels)}>
  <svg viewBox="0 0 600 380" role="img" aria-label={WALLS[now].label} set:html={sets} />
  <span class="caption" data-wall-label>{WALLS[now].label}</span>
</div>
<script>
  // ビルドした月と閲覧した月がずれても、閲覧日の季節を表示する
  const el = document.querySelector<HTMLElement>('.wall');
  if (el) {
    const m = new Date().getMonth() + 1;
    const s = m >= 3 && m <= 5 ? 'spring' : m >= 6 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
    const labels = JSON.parse(el.dataset.labels || '{}');
    el.dataset.active = s;
    const cap = el.querySelector('[data-wall-label]');
    if (cap && labels[s]) cap.textContent = labels[s];
    el.querySelector('svg')?.setAttribute('aria-label', labels[s] || '');
  }
</script>
<style>
  .wall { position: relative; background: var(--wall); border-radius: var(--radius); overflow: hidden; }
  .wall svg { display: block; width: 100%; height: auto; }
  .wall :global(.set) { display: none; }
  .wall[data-active='spring'] :global(.set[data-season='spring']),
  .wall[data-active='summer'] :global(.set[data-season='summer']),
  .wall[data-active='autumn'] :global(.set[data-season='autumn']),
  .wall[data-active='winter'] :global(.set[data-season='winter']) { display: inline; }
  .wall :global(.pin) { transform-box: fill-box; transform-origin: center; animation: pin .7s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d); }
  @keyframes pin {
    0% { opacity: 0; transform: translateY(-24px) scale(1.06); }
    70% { opacity: 1; transform: translateY(3px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .caption { position: absolute; left: 4%; bottom: 7%; background: var(--card); padding: 6px 14px; font-family: var(--font-display); font-weight: 700; font-size: 15px; transform: rotate(-1.5deg); }
  @media (max-width: 720px) { .caption { font-size: 13px; } }
</style>
