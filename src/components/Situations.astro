---
import { SITUATIONS, type SituationKey } from '../lib/taxonomy';
const keys = Object.keys(SITUATIONS) as SituationKey[];
---
<section aria-labelledby="situation-h" class="wrap situations no-print">
  <h2 id="situation-h">きょうは、どんな日ですか？</h2>
  <div class="grid">
    {keys.map((k) => (
      <a href={`/situation/${k}/`} class="btn-situation">
        <span class="label">{SITUATIONS[k].label}</span>
        <span class="note">{SITUATIONS[k].note}</span>
      </a>
    ))}
  </div>
</section>
<style>
  .situations { padding-block: 8px 32px; }
  h2 { font-size: 24px; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .btn-situation { display: flex; flex-direction: column; gap: 4px; min-height: 92px; padding: 16px 20px; background: var(--card); border: 2px solid var(--ink); border-radius: var(--radius); text-decoration: none; color: var(--ink); }
  .btn-situation:hover { background: var(--tape-bg); color: var(--ink); }
  .label { font-family: var(--font-display); font-weight: 700; font-size: 19px; }
  .note { font-size: 14px; color: var(--ink-2); }
  @media (max-width: 720px) {
    h2 { font-size: 19px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .btn-situation { min-height: 84px; padding: 12px 14px; }
    .label { font-size: 16px; }
    .note { font-size: 12px; }
  }
</style>
